{
  "name": "Clojure",
  "scopeName": "source.clojure",
  "type": "tree-sitter",
  "injectionNames": ["clojure"],
  "parser": "tree-sitter-clojure",
  // Recognizes Boot shebangs and editor modelines for extensionless files.
  "firstLineRegex": [
    "^#!.*\\bboot\\b",
    "-\\*-[^*]*\\bmode\\s*:\\s*clojure(script)?\\b[^*]*-\\*-",
    "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=clojure"
  ],
  "fileTypes": [
    "boot",
    "clj",
    "clje",
    "cljr",
    "clj.hl",
    "cljc",
    "cljs",
    "cljs.hl",
    "cljx",
    "clojure",
    "edn",
    "bb",
    "joke",
    "joker",
    "jank"
  ],
  "treeSitter": {
    "parserSource": "github:mauricioszabo/tree-sitter-clojure#59051aa9c4344d9f8d81264b423b7fd5199cc2d6",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "clojure.wasm",
    "highlightsQuery": ["clojure-highlights.scm", "clojure-edn-highlights.scm"],
    "foldsQuery": "clojure-folds.scm",
    "tagsQuery": "clojure-tags.scm"
  }
}
