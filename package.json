{
  "name": "language-clojure",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "lib/main",
  "description": "Clojure language support.",
  "keywords": [
    "clj",
    "cljs",
    "cljc",
    "edn",
    "lisp",
    "babashka",
    "joker",
    "tree-sitter"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=12"
  },
  "repository": "https://github.com/lumine-code/language-clojure",
  "license": "MIT",
  "configSchema": {
    "dismissTag": {
      "title": "Dismiss Tag",
      "description": "Highlights forms after #_ as comments",
      "type": "boolean",
      "default": true
    },
    "commentTag": {
      "title": "Comment Tag",
      "description": "Highlights forms like (comment ...) as comments",
      "type": "boolean",
      "default": false
    },
    "markDeprecations": {
      "title": "Mark Deprecations",
      "description": "Marks deprecations like `use`",
      "type": "boolean",
      "default": true
    }
  },
  "bugs": {
    "url": "https://github.com/lumine-code/language-clojure/issues"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
